# -*- coding: utf-8 -*-
# vim: ft=yaml
# ==============================================================================
# Claude Code Agent Formula Pillar Configuration Example
# ==============================================================================

claude-code-tui:
  # ============================================================================
  # MANAGED AGENT CONFIGURATION DIRECTIVES (config)
  # ============================================================================
  config:
    managed-settings.json: |-
      {
        "env": {
          "ANTHROPIC_BASE_URL": "https://api.anthropic.com"
          "ANTHROPIC_API_KEY": "<YOUR_API_TOKEN_KEY_HERE>"
        },
        "parentSettingsBehavior": "merge"
      }
    managed-settings.d/api_token.json: |-
      {
      }
    # Linux target root directory
    root_dir: '/etc/claude-code'
    # Windows target root directory override
    # root_dir: 'C:\ProgramData\claude-code'

  # ============================================================================
  # PACKAGING & INSTALLATION DIRECTIVES
  # ============================================================================
  # Primary deployment strategy selector: 'npm', 'rpm', or 'script'.
  # Default on Linux and Windows is 'script'.
  install_method: 'npm'

  # Script-Based Installation Settings (install_method: script)
  install_script:
    creates: '/usr/local/bin/claude'
    env:
      CLAUDE_INSTALL_ALLOW_SUDO: '1'
    group: 'root'
    mode: '0755'
    skip_verify: false
    source: 'https://claude.ai/install.sh'
    target: '/tmp/claude_code_install.sh'
    user: 'root'

  # Package Dependency & Module Identifiers
  pkg:
    npm:
      name: '@anthropic-ai/claude-code'
    rpm:
      name: 'claude-code'
